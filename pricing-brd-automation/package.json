{
  "name": "pricing-brd-automation",
  "version": "1.0.0",
  "description": "Playwright automation framework for Pricing BRD - Multi-Product Range in Supply Chain Management",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:cost-plus": "npx playwright test tests/cost-plus-pricing/",
    "test:tiered": "npx playwright test tests/tiered-volume-pricing/",
    "test:channel": "npx playwright test tests/segment-channel-pricing/",
    "test:lifecycle": "npx playwright test tests/lifecycle-pricing/",
    "test:adjustments": "npx playwright test tests/price-adjustment-ordering/",
    "test:guardrails": "npx playwright test tests/margin-guardrails/",
    "test:fx": "npx playwright test tests/multi-currency-fx/",
    "test:commodity": "npx playwright test tests/commodity-pricing/",
    "test:perishables": "npx playwright test tests/perishables-markdown/",
    "test:regulated": "npx playwright test tests/regulated-goods/",
    "test:configurable": "npx playwright test tests/configurable-assemblies/",
    "test:oversized": "npx playwright test tests/oversized-bulky-items/",
    "test:mro": "npx playwright test tests/mro-spare-parts/",
    "test:contract": "npx playwright test tests/contract-pricing/",
    "test:rebate": "npx playwright test tests/rebate-programs/",
    "test:npi": "npx playwright test tests/npi-pricing-workflow/",
    "test:price-change": "npx playwright test tests/price-change-workflow/",
    "test:deal": "npx playwright test tests/deal-pricing-override/",
    "test:business-rules": "npx playwright test tests/business-rules/",
    "test:freight": "npx playwright test tests/freight-incoterm-pricing/",
    "test:data-quality": "npx playwright test tests/data-quality/",
    "test:audit": "npx playwright test tests/audit-compliance/",
    "test:integrations": "npx playwright test tests/integrations/",
    "test:nfr": "npx playwright test tests/non-functional/",
    "test:reporting": "npx playwright test tests/reporting-analytics/",
    "test:migration": "npx playwright test tests/migration-cutover/",
    "test:edge": "npx playwright test tests/edge-cases/",
    "report:allure:generate": "npx allure generate reports/allure-results --clean -o reports/allure-report",
    "report:allure:open": "npx allure open reports/allure-report",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "report:extent": "npx ts-node src/utils/extent-report-generator.ts",
    "lint": "npx eslint 'src/**/*.ts' 'tests/**/*.ts' --max-warnings 0",
    "lint:fix": "npx eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "npx prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "npx tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "luxon": "^3.5.0",
    "winston": "^3.17.0"
  }
}
